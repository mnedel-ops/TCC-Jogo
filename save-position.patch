+static func _read_position(raw) -> Dictionary:
+	if not (raw is Dictionary):
+		return {}
+	var level = raw.get("level")
+	if not (level is String) or level == "":
+		return {}
+	var out := {"level": level}
+	for k in ["x", "y", "z", "yaw"]:
+		var v = raw.get(k, 0.0)
+		if not (v is float or v is int) or not is_finite(float(v)):
+			return {}
+		out[k] = float(v)
+	return out
