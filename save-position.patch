diff --git a/tcc-jogo/scenes/scene_manager.gd b/tcc-jogo/scenes/scene_manager.gd
index 02254c6..1740e0f 100644
--- a/tcc-jogo/scenes/scene_manager.gd
+++ b/tcc-jogo/scenes/scene_manager.gd
@@ -13,6 +13,8 @@ signal ChangeScene
 
 func _ready() -> void:
 	add_to_group("scene_manager")
+	if _resume_saved_position(GameSession.take_resume_position()):
+		return
 	if first_level:
 		change_level(first_level, first_spawn_point)
 
@@ -20,19 +22,58 @@ func change_level(new_level_scene: PackedScene, spawn_point_name: String) -> voi
 	if new_level_scene == null:
 		push_error("Cena destino não configurada para porta.")
 		return
-		
-	if _current_level:
-		_current_level.queue_free()
-	var new_level: = new_level_scene.instantiate() 
-	level_holder.add_child(new_level)
-	_current_level = new_level
-	
+
+	var new_level := _swap_level(new_level_scene)
 	var spawn := new_level.get_node_or_null(spawn_point_name) as Marker3D
-	
+
 	if spawn == null:
 		push_warning("Spawn '%s' nao existe em %s" % [spawn_point_name, new_level.name])
 		return
-		
+
+	_place_player(spawn.global_transform)
+
+
+## Where to put the player on Load. false = bad data / level gone: caller falls back to the first level.
+func _resume_saved_position(pos: Dictionary) -> bool:
+	if pos.is_empty():
+		return false
+	var path := String(pos.get("level", ""))
+	var scene := load(path) as PackedScene if ResourceLoader.exists(path) else null
+	if scene == null:
+		push_warning("Saved level '%s' not found, starting at the first level." % path)
+		return false
+
+	_swap_level(scene)
+	_place_player(Transform3D(Basis(), Vector3(pos["x"], pos["y"], pos["z"])))
+	var mesh := player.get_node_or_null("Mesh") as Node3D   # the Mesh turns, the body does not
+	if mesh != null:
+		mesh.global_rotation.y = float(pos["yaw"])
+	return true
+
+
+## What GameSession writes in the save: current level + where the player stands/faces.
+func get_save_position() -> Dictionary:
+	if _current_level == null or _current_level.scene_file_path == "":
+		return {}
+	var p := player.global_position
+	var mesh := player.get_node_or_null("Mesh") as Node3D
+	return {
+		"level": _current_level.scene_file_path,
+		"x": p.x, "y": p.y, "z": p.z,
+		"yaw": mesh.global_rotation.y if mesh != null else 0.0,
+	}
+
+
+func _swap_level(new_level_scene: PackedScene) -> Node3D:
+	if _current_level:
+		_current_level.queue_free()
+	var new_level := new_level_scene.instantiate() as Node3D
+	level_holder.add_child(new_level)
+	_current_level = new_level
+	return new_level
+
+
+func _place_player(xform: Transform3D) -> void:
 	player.velocity = Vector3.ZERO             # zera momentum, evita herdar impulso da scene anterior
-	player.global_transform = spawn.global_transform
+	player.global_transform = xform
 	camera_rig.set_player(player)
diff --git a/tcc-jogo/test/test_creature_persistence.gd b/tcc-jogo/test/test_creature_persistence.gd
index aa9610c..a665581 100644
--- a/tcc-jogo/test/test_creature_persistence.gd
+++ b/tcc-jogo/test/test_creature_persistence.gd
@@ -474,3 +474,39 @@ func test_no_file_until_player_saves_and_save_replaces() -> void:
 	assert_int(s.save_game()).is_equal(OK)                      # save again = same file, new content
 	var data := SaveGame.read_file(TMP_SAVE)
 	assert_int(int(data["player"]["money"])).is_equal(s.player.money)
+
+
+func test_position_roundtrip_and_resume_once() -> void:
+	var s := _session(TMP_SAVE)
+	s.world_position = {"level": "res://scenes/scene_2.tscn", "x": 1.5, "y": 0.25, "z": -7.0, "yaw": 1.2}
+	assert_int(s.save_game()).is_equal(OK)    # no scene manager in the test tree: keeps the dict
+	s.world_position = {}
+	assert_int(s.load_game(false)).is_equal(OK)
+	assert_str(s.world_position["level"]).is_equal("res://scenes/scene_2.tscn")
+	assert_float(s.world_position["x"]).is_equal(1.5)
+	assert_float(s.world_position["yaw"]).is_equal_approx(1.2, 0.0001)
+	assert_bool(s.take_resume_position().is_empty()).is_false()
+	assert_bool(s.take_resume_position().is_empty()).is_true()   # consumed: a door/reload must not teleport again
+
+
+func test_new_game_forgets_position() -> void:
+	var s := _session(TMP_SAVE)
+	s.world_position = {"level": "res://scenes/scene_2.tscn", "x": 1.0, "y": 0.0, "z": 1.0, "yaw": 0.0}
+	assert_int(s.new_game()).is_equal(OK)
+	assert_bool(s.world_position.is_empty()).is_true()
+	assert_bool(s.take_resume_position().is_empty()).is_true()
+
+
+func test_bad_or_missing_position_loads_as_empty() -> void:
+	var w := _world()
+	for bad in [null, 5, {}, {"level": ""}, {"level": "res://a.tscn", "x": "no", "y": 0, "z": 0}]:
+		var data := SaveGame.serialize(w.party, w.storage, w.bond, w.player)
+		data["position"] = bad
+		var pos := {"level": "stale"}
+		assert_int(SaveGame.apply(data, w.party, w.storage, w.bond, w.player, {}, null, pos)).is_equal(OK)
+		assert_bool(pos.is_empty()).is_true()
+	var old := SaveGame.serialize(w.party, w.storage, w.bond, w.player)
+	old.erase("position")
+	var pos2 := {"level": "stale"}
+	assert_int(SaveGame.apply(old, w.party, w.storage, w.bond, w.player, {}, null, pos2)).is_equal(OK)
+	assert_bool(pos2.is_empty()).is_true()
