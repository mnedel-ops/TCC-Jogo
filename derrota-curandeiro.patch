index 0000000..770d01d
--- /dev/null
+++ b/tcc-jogo/DATABASE/Player/healer_registry.gd
@@ -0,0 +1,72 @@
+class_name HealerRegistry
+extends RefCounted
+
+# id do NPC -> {level, x, y, z (onde o jogador fica de frente), nx, ny, nz (NPC), seq (ordem da visita)}
+
+
+static func register(reg: Dictionary, id: String, level: String, stand: Vector3, npc_pos: Vector3) -> void:
+	if id == "" or level == "":
+		return
+	reg[id] = {
+		"level": level,
+		"x": stand.x, "y": stand.y, "z": stand.z,
+		"nx": npc_pos.x, "ny": npc_pos.y, "nz": npc_pos.z,
+		"seq": _max_seq(reg) + 1,
+	}
+
+
+# Curandeiro visitado mais próximo na fase atual. Sem nenhum na fase, o último visitado em outra.
+static func nearest(reg: Dictionary, level: String, from: Vector3) -> Dictionary:
+	var best_id := ""
+	var best_dist := INF
+	for id in reg:
+		var e: Dictionary = reg[id]
+		if e["level"] != level:
+			continue
+		var d := Vector2(from.x - e["x"], from.z - e["z"]).length()
+		if d < best_dist:
+			best_dist = d
+			best_id = id
+	if best_id == "":
+		var best_seq := -1
+		for id in reg:
+			if int(reg[id]["seq"]) > best_seq:
+				best_seq = int(reg[id]["seq"])
+				best_id = id
+	if best_id == "":
+		return {}
+	var out: Dictionary = reg[best_id].duplicate()
+	out["id"] = best_id
+	return out
+
+
+static func to_array(reg: Dictionary) -> Array:
+	var out: Array = []
+	for id in reg:
+		var e: Dictionary = reg[id].duplicate()
+		e["id"] = id
+		out.append(e)
+	return out
+
+
+static func from_array(raw) -> Dictionary:
+	var out := {}
+	if not (raw is Array):
+		return out
+	for e in raw:
+		if not (e is Dictionary) or not (e.get("id") is String) or not (e.get("level") is String):
+			continue
+		if e["id"] == "" or e["level"] == "":
+			continue
+		var entry := {"level": e["level"], "seq": int(e.get("seq", 0))}
+		for k in ["x", "y", "z", "nx", "ny", "nz"]:
+			entry[k] = float(e.get(k, 0.0))
+		out[e["id"]] = entry
+	return out
+
+
+static func _max_seq(reg: Dictionary) -> int:
+	var m := 0
+	for id in reg:
+		m = maxi(m, int(reg[id]["seq"]))
+	return m
