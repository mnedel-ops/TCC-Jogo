+func teleport_to_healer(dest: Dictionary) -> NPC:
+	var path := String(dest.get("level", ""))
+	if path != current_level_path():
+		var scene := load(path) as PackedScene if ResourceLoader.exists(path) else null
+		if scene == null:
+			push_warning("Healer level '%s' not found." % path)
+			return null
+		_swap_level(scene)
+	var stand := Vector3(dest["x"], dest["y"], dest["z"])
+	_place_player(Transform3D(Basis(), stand))
+	var look := Vector3(dest["nx"], dest["ny"], dest["nz"]) - stand
+	var mesh := player.get_node_or_null("Mesh") as Node3D
+	if mesh != null:
+		mesh.global_rotation.y = atan2(-look.x, -look.z)
+	return find_npc(String(dest.get("id", "")))
+
+
