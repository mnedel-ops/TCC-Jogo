diff --git a/tcc-jogo/test/test_healer_registry.gd b/tcc-jogo/test/test_healer_registry.gd
new file mode 100644
index 0000000..33d72f8
--- /dev/null
+++ b/tcc-jogo/test/test_healer_registry.gd
@@ -0,0 +1,56 @@
+extends GdUnitTestSuite
+
+const L1 := "res://scenes/scene_1.tscn"
+const L2 := "res://scenes/scene_2.tscn"
+
+
+func test_nearest_prefers_same_level_by_distance() -> void:
+	var reg := {}
+	HealerRegistry.register(reg, "a", L1, Vector3(10, 0, 0), Vector3(11, 0, 0))
+	HealerRegistry.register(reg, "b", L1, Vector3(-3, 0, 2), Vector3(-4, 0, 2))
+	HealerRegistry.register(reg, "c", L2, Vector3(0, 0, 0), Vector3(1, 0, 0))
+	assert_str(HealerRegistry.nearest(reg, L1, Vector3.ZERO)["id"]).is_equal("b")
+	assert_str(HealerRegistry.nearest(reg, L1, Vector3(9, 0, 1))["id"]).is_equal("a")
+
+
+func test_nearest_falls_back_to_latest_visit_on_other_level() -> void:
+	var reg := {}
+	HealerRegistry.register(reg, "a", L1, Vector3.ZERO, Vector3.ONE)
+	HealerRegistry.register(reg, "b", L1, Vector3(5, 0, 5), Vector3.ONE)
+	assert_str(HealerRegistry.nearest(reg, L2, Vector3.ZERO)["id"]).is_equal("b")
+	HealerRegistry.register(reg, "a", L1, Vector3.ZERO, Vector3.ONE)
+	assert_str(HealerRegistry.nearest(reg, L2, Vector3.ZERO)["id"]).is_equal("a")
+
+
+func test_empty_registry_and_invalid_entries() -> void:
+	var reg := {}
+	assert_bool(HealerRegistry.nearest(reg, L1, Vector3.ZERO).is_empty()).is_true()
+	HealerRegistry.register(reg, "", L1, Vector3.ZERO, Vector3.ZERO)
+	HealerRegistry.register(reg, "x", "", Vector3.ZERO, Vector3.ZERO)
+	assert_int(reg.size()).is_equal(0)
+
+
+func test_array_roundtrip_ignores_garbage() -> void:
+	var reg := {}
+	HealerRegistry.register(reg, "a", L1, Vector3(1, 2, 3), Vector3(4, 5, 6))
+	var raw := HealerRegistry.to_array(reg)
+	raw.append("lixo")
+	raw.append({"id": 5})
+	var back := HealerRegistry.from_array(raw)
+	assert_int(back.size()).is_equal(1)
+	assert_float(back["a"]["nz"]).is_equal(6.0)
+	assert_int(HealerRegistry.from_array(null).size()).is_equal(0)
+
+
+func test_save_game_keeps_visited_healers() -> void:
+	var party := PlayerPartyData.new()
+	var storage := CapturedStorage.new()
+	var bond := PlayerBondData.new()
+	var player := PlayerData.new()
+	var reg := {}
+	HealerRegistry.register(reg, "scene_1/SpawnPoint5", L1, Vector3(-6, 0, 7.2), Vector3(-6, 0, 6))
+	var data := SaveGame.serialize(party, storage, bond, player, {}, null, {}, reg)
+	var loaded := {}
+	assert_int(SaveGame.apply(data, party, storage, bond, player, {}, null, {}, loaded)).is_equal(OK)
+	assert_bool(loaded.has("scene_1/SpawnPoint5")).is_true()
+	assert_float(loaded["scene_1/SpawnPoint5"]["z"]).is_equal_approx(7.2, 0.001)
