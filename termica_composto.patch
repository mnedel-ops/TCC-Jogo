+	var expected := ThermalRules.transition_damage(AlchemonSheet.SOLIDO, AlchemonSheet.LIQUIDO, max_hp, 10)
+	assert_str(_th(st).physical_state).is_equal(AlchemonSheet.LIQUIDO)
