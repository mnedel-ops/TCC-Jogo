+
+func test_fusion_damages_active_only_and_keeps_bond_and_stats() -> void:
+	var st := _ionic_pair()
+	var active := st.get_combatant(2)
+	var cation := st.get_combatant(1)
+	var max_hp := active.max_hp
+	var cation_hp := cation.hp
