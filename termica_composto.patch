+	_th(st).max_delta_t = 5.0
+	var hp_before := f.hp
+	_hit(st, 100.0)
+	var f_hp_after_break := mini(hp_before, 100) # clamp ao max_hp restaurado
+	assert_int(f.hp).is_equal(f_hp_after_break)
+	assert_bool(li.has_thermal_shock).is_true()
