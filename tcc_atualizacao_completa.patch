+extends GdUnitTestSuite
+## A insígnia controla a obediência dos Alchemons de nível 16+.
+
+
+func test_level_15_always_obeys() -> void:
+	assert_bool(ObedienceRules.disobeys(15, 0, 0.0)).is_false()
+
+
+func test_level_16_without_badge_can_disobey() -> void:
+	assert_bool(ObedienceRules.disobeys(16, 0, 0.0)).is_true()
+	assert_bool(ObedienceRules.disobeys(16, 0, 0.99)).is_false()
+
+
+func test_badge_controls_high_level() -> void:
+	assert_bool(ObedienceRules.disobeys(40, 1, 0.0)).is_false()
+
+
+func test_badges_earned_counts_only_earned() -> void:
+	var p := PlayerData.new()
+	var a := BadgeData.new()
+	a.earned = true
+	var b := BadgeData.new()
+	p.badges.append(a)
+	p.badges.append(b)
+	assert_int(ObedienceRules.badges_earned(p)).is_equal(1)
+	assert_int(ObedienceRules.badges_earned(null)).is_equal(0)
