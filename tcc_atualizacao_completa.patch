index 0000000..326c8cf
--- /dev/null
+++ b/tcc-jogo/test/test_compound_formulas.gd
@@ -0,0 +1,125 @@
+extends GdUnitTestSuite
+## Atributos do Composto (HP máx, Ataque, Defesa, Velocidade):
+##   iônico:    X_C = X_ânion + α·X_cátion, α = clamp(0,50 + 0,10·ΔE + 0,05·Z, 0,50, 0,95)
+##   covalente: X_C = X_receptor + α·X_doador, α = 0,50 + 0,10·P
+
+var db: AlchemonDatabase
+
+
+func before_test() -> void:
+	db = AlchemonDatabase.new()
+
+
+func _sheet(id: int, number: int, etype: AlchemonType.Type, valence: int, en: float) -> AlchemonSheet:
+	var s := AlchemonSheet.new("E%d" % id, 100, id)
+	s.atomic_number = number
+	s.atomic_mass = number * 2
+	s.element_type = etype
+	s.valence_electrons = valence
+	s.electronegativity = en
+	s.melting_point = 100.0
+	s.boiling_point = 200.0
+	db.alchemons.append(s)
+	return s
+
+
+func _c(id: int, sheet: AlchemonSheet, level: int, hp: int, atk: int, df: int, spd: int, slot: int) -> CombatantState:
+	var c := CombatantState.new(id, sheet.id, hp, true, slot, 10)
+	c.level = level
+	c.attack = atk
+	c.defense = df
+	c.mechanical_speed = spd
+	return c
+
+
+func _state(list: Array) -> CombatState:
+	var st := CombatState.new()
+	for c in list:
+		st.combatants[c.id] = c
+		st.player_ids.append(c.id)
+	return st
+
+
+func test_alpha_ionic_clamps() -> void:
+	assert_float(BondRules.ionic_alpha(3.0, 1)).is_equal_approx(0.5 + 0.3 + 0.05, 0.0001)
+	assert_float(BondRules.ionic_alpha(0.0, 0)).is_equal_approx(0.5, 0.0001)
+	assert_float(BondRules.ionic_alpha(10.0, 3)).is_equal_approx(0.95, 0.0001)
+
+
+func test_alpha_covalent_by_bond_order() -> void:
+	assert_float(BondRules.covalent_alpha(1)).is_equal_approx(0.6, 0.0001)
+	assert_float(BondRules.covalent_alpha(2)).is_equal_approx(0.7, 0.0001)
+	assert_float(BondRules.covalent_alpha(3)).is_equal_approx(0.8, 0.0001)
+
+
+func test_ionic_li_f_anion_receives_cation_share() -> void:
+	var li_s := _sheet(1, 3, AlchemonType.Type.METAL, 1, 0.98)
+	var f_s := _sheet(2, 9, AlchemonType.Type.AMETAL, 7, 3.98)
+	var li := _c(1, li_s, 5, 50, 20, 30, 40, 0)
+	var f := _c(2, f_s, 10, 100, 60, 50, 70, 1)
+	var st := _state([li, f])
+	var res := BondRules.apply_bond(BondRules.COMPOUND, [li, f], [li_s, f_s], st)
+	assert_str(res["kind"]).is_equal("compound_formed")
+	assert_int(int(res["active_id"])).is_equal(2)
+	# ΔE = 3,00 ; Z(Li) = 1 -> α = 0,5 + 0,3 + 0,05 = 0,85
+	assert_int(f.max_hp).is_equal(100 + int(floor(50 * 0.85)))
+	assert_int(f.attack).is_equal(60 + int(floor(20 * 0.85)))
+	assert_int(f.defense).is_equal(50 + int(floor(30 * 0.85)))
+	assert_int(f.mechanical_speed).is_equal(70 + int(floor(40 * 0.85)))
+	assert_int(f.hp).is_equal(f.max_hp)
+	# Doador não muda.
+	assert_int(li.max_hp).is_equal(50)
+	assert_int(li.attack).is_equal(20)
+
+
+func test_break_compound_restores_receptor_stats() -> void:
+	var li_s := _sheet(1, 3, AlchemonType.Type.METAL, 1, 0.98)
+	var f_s := _sheet(2, 9, AlchemonType.Type.AMETAL, 7, 3.98)
+	var li := _c(1, li_s, 5, 50, 20, 30, 40, 0)
+	var f := _c(2, f_s, 10, 100, 60, 50, 70, 1)
+	var st := _state([li, f])
+	BondRules.apply_bond(BondRules.COMPOUND, [li, f], [li_s, f_s], st)
+	assert_bool(BondRules.break_compound(st, f)).is_true()
+	assert_int(f.max_hp).is_equal(100)
+	assert_int(f.attack).is_equal(60)
+	assert_int(f.defense).is_equal(50)
+	assert_int(f.mechanical_speed).is_equal(70)
+	assert_int(li.compound_gain.size()).is_equal(0)
+
+
+func test_covalent_most_electronegative_is_receptor_and_order_sets_alpha() -> void:
+	# O=O (ordem 2): empate de eletronegatividade -> maior nível recebe; α = 0,70.
+	var o_s := _sheet(3, 8, AlchemonType.Type.AMETAL, 6, 3.44)
+	var a := _c(1, o_s, 5, 50, 20, 30, 40, 0)
+	var b := _c(2, o_s, 10, 100, 60, 50, 70, 1)
+	var st := _state([a, b])
+	var res := BondRules.apply_bond(BondRules.COMPOUND, [a, b], [o_s, o_s], st)
+	assert_str(res["kind"]).is_equal("compound_formed")
+	assert_int(int(res["active_id"])).is_equal(2)
+	assert_int(b.max_hp).is_equal(100 + int(floor(50 * 0.7)))
+	assert_int(b.attack).is_equal(60 + int(floor(20 * 0.7)))
+
+
+func test_covalent_less_electronegative_donates() -> void:
+	# Cl (3,16) + F (3,98): ΔE < 2 -> covalente. F é o receptor mesmo com nível menor.
+	var cl_s := _sheet(4, 17, AlchemonType.Type.AMETAL, 7, 3.16)
+	var f_s := _sheet(2, 9, AlchemonType.Type.AMETAL, 7, 3.98)
+	var cl := _c(1, cl_s, 12, 80, 40, 40, 40, 0)
+	var f := _c(2, f_s, 5, 60, 30, 30, 30, 1)
+	var st := _state([cl, f])
+	var res := BondRules.apply_bond(BondRules.COMPOUND, [cl, f], [cl_s, f_s], st)
+	assert_str(res["kind"]).is_equal("compound_formed")
+	assert_int(int(res["active_id"])).is_equal(2)
+	assert_int(f.max_hp).is_equal(60 + int(floor(80 * 0.6)))
+
+
+func test_fusion_keeps_receptor_hp_percentage() -> void:
+	var li_s := _sheet(1, 3, AlchemonType.Type.METAL, 1, 0.98)
+	var f_s := _sheet(2, 9, AlchemonType.Type.AMETAL, 7, 3.98)
+	var li := _c(1, li_s, 5, 50, 20, 30, 40, 0)
+	var f := _c(2, f_s, 10, 100, 60, 50, 70, 1)
+	f.hp = 50 # 50 % do HP máximo
+	var st := _state([li, f])
+	BondRules.apply_bond(BondRules.COMPOUND, [li, f], [li_s, f_s], st)
+	assert_int(f.max_hp).is_equal(142)
+	assert_int(f.hp).is_equal(71)
