@@ -0,0 +1,31 @@
+class_name ObedienceRules
+extends RefCounted
+## Obediência: a insígnia controla os Alchemons de alto nível.
+##
+## Até o nível OBEDIENCE_FREE_LEVEL (15) o Alchemon sempre obedece. A partir do
+## nível 16 ele só obedece sempre se o jogador tem pelo menos uma insígnia;
+## sem insígnia, ignora o comando com chance DISOBEY_CHANCE e perde a ação.
+
+const OBEDIENCE_FREE_LEVEL := 15
+const BADGES_TO_CONTROL_HIGH_LEVEL := 1
+const DISOBEY_CHANCE := 0.5
+
+
+static func badges_earned(player: PlayerData) -> int:
+	var n := 0
+	if player == null:
+		return n
+	for b in player.badges:
+		if b != null and b.earned:
+			n += 1
+	return n
+
+
+## true = nível alto e o jogador ainda não tem insígnias suficientes.
+static func is_uncontrolled(level: int, badges: int) -> bool:
+	return level > OBEDIENCE_FREE_LEVEL and badges < BADGES_TO_CONTROL_HIGH_LEVEL
+
+
+## `roll` em [0, 1): injetável nos testes.
+static func disobeys(level: int, badges: int, roll: float = randf()) -> bool:
+	return is_uncontrolled(level, badges) and roll < DISOBEY_CHANCE
