--- "a/docs/ALCHEMON \342\200\224 Documento de Design de Jogo (GDD).md"	
+++ "b/docs/ALCHEMON \342\200\224 Documento de Design de Jogo (GDD).md"	
@@ -550,7 +550,7 @@ Ver seção 8.1.
 - **Nível:** \[Parcial\] não há teto de nível 20 no código.
 - **Level up** (`AlchemonGrowth.level_up`): recalcula ataque, defesa e velocidade, aumenta o limite de energia (sem restaurar a atual) e o HP máximo (somado ao HP atual se vivo). Múltiplos níveis por recompensa \[OK\].
 - **XP necessário:** \[Parcial\] fixo, `XP_TO_LEVEL_UP = 100` por nível, com sobra preservada.
-- **XP ganho:** \[Parcial\] vem de `xp_reward` da espécie derrotada (padrão 100). A fórmula do GDD (seção 12.1) **não está implementada**.
+- **XP ganho:** \[OK\] `EXP = ((a × b × L) / 5) / 2` (`AlchemonGrowth.xp_for_defeat`). `a` = 1 (selvagem) ou 1,5 (treinador); `b` = `xp_reward` da espécie derrotada (padrão 100); `L` = nível do derrotado. Arredonda para baixo, mínimo 1.
 - **Distribuição:** \[Parcial\] `_grant_xp` concede XP **somente à criatura que derrotou/capturou** o alvo, e não igualmente às duas.
 - Tela de recompensas mostra XP, level up e moedas \[OK\] (`BattleRewards.entries`).
 
diff --git a/tcc-jogo/COMBAT/alchemon_growth.gd b/tcc-jogo/COMBAT/alchemon_growth.gd
index 061dfbc..b0aebee 100644
--- a/tcc-jogo/COMBAT/alchemon_growth.gd
+++ b/tcc-jogo/COMBAT/alchemon_growth.gd
@@ -38,6 +38,19 @@ static func level_up(combatant: CombatantState, template: AlchemonSheet, levels:
 		AttackLearning.on_level_reached(combatant, template, combatant.level)
 		print("LVUP %s Lv%d atk=%d def=%d spd=%d en=%d" % [combatant.id, combatant.level, combatant.attack, combatant.defense, combatant.mechanical_speed, combatant.action_energy])
 
+
+const WILD_MULT := 1.0
+const TRAINER_MULT := 1.5
+
+
+# EXP = ((a * b * L) / 5) / 2
+# a: 1.0 selvagem, 1.5 treinador | b: xp_reward da espécie derrotada | L: nível do derrotado.
+# Arredonda para baixo; mínimo 1 para nunca zerar o ganho.
+static func xp_for_defeat(is_trainer_battle: bool, base_yield: int, defeated_level: int) -> int:
+	var a := TRAINER_MULT if is_trainer_battle else WILD_MULT
+	return maxi(int(floor(((a * base_yield * defeated_level) / 5.0) / 2.0)), 1)
+
+
 static func grant_experience(combatant: CombatantState, template: AlchemonSheet, amount: int) -> void:
 	if amount <= 0:
 		return
