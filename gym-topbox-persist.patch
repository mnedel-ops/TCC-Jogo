diff --git a/tcc-jogo/DATABASE/Player/PlayerData.gd b/tcc-jogo/DATABASE/Player/PlayerData.gd
index 0908dac..8ff19ee 100644
--- a/tcc-jogo/DATABASE/Player/PlayerData.gd
+++ b/tcc-jogo/DATABASE/Player/PlayerData.gd
@@ -29,3 +29,26 @@ func add_money(amount: int) -> void:
 
 func get_team_name() -> String:
 	return team_name if team_name != "" else "Equipe do %s" % player_name
+
+
+## Marks `badge` as earned. Uses the copy that is already in `badges` (same name),
+## so the Player page slot and the save (by slot index) stay in sync. Returns
+## false if it was already earned or null.
+func award_badge(badge: BadgeData) -> bool:
+	if badge == null:
+		return false
+	var slot: BadgeData = badge
+	var found := false
+	for b in badges:
+		if b != null and (b == badge or b.badge_name == badge.badge_name):
+			slot = b
+			found = true
+			break
+	if slot.earned:
+		return false
+	if not found:
+		push_warning("PlayerData: badge '%s' is not in player.tres badges. Added now, but it will not be saved." % badge.badge_name)
+		badges.append(slot)
+	slot.earned = true
+	emit_changed()
+	return true
